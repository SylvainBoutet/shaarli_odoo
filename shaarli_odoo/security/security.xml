<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups -->
    <record id="module_bookmark_manager" model="ir.module.category">
        <field name="name">Bookmark Management</field>
        <field name="description">User access level for Bookmarks</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_bookmark_user" model="res.groups">
        <field name="name">Bookmark User</field>
        <field name="category_id" ref="module_bookmark_manager"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_bookmark_manager" model="res.groups">
        <field name="name">Bookmark Manager</field>
        <field name="category_id" ref="module_bookmark_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_bookmark_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <!-- Record rules: users read their bookmarks and the public ones,
         and only modify their own; managers see and modify everything -->
    <record id="rule_bookmark_user_read" model="ir.rule">
        <field name="name">Bookmarks: read own and public</field>
        <field name="model_id" ref="model_odoo_bookmark"/>
        <field name="groups" eval="[(4, ref('group_bookmark_user'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('is_public', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_bookmark_user_write" model="ir.rule">
        <field name="name">Bookmarks: modify own</field>
        <field name="model_id" ref="model_odoo_bookmark"/>
        <field name="groups" eval="[(4, ref('group_bookmark_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_bookmark_manager" model="ir.rule">
        <field name="name">Bookmarks: managers see and modify all</field>
        <field name="model_id" ref="model_odoo_bookmark"/>
        <field name="groups" eval="[(4, ref('group_bookmark_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_bookmark_public" model="ir.rule">
        <field name="name">Bookmarks: public users read public bookmarks</field>
        <field name="model_id" ref="model_odoo_bookmark"/>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        <field name="domain_force">[('is_public', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Tags are shared for reading (they show on public bookmarks);
         users only modify their own tags -->
    <record id="rule_bookmark_tag_user_write" model="ir.rule">
        <field name="name">Bookmark tags: modify own</field>
        <field name="model_id" ref="model_odoo_bookmark_tag"/>
        <field name="groups" eval="[(4, ref('group_bookmark_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_bookmark_tag_manager" model="ir.rule">
        <field name="name">Bookmark tags: managers modify all</field>
        <field name="model_id" ref="model_odoo_bookmark_tag"/>
        <field name="groups" eval="[(4, ref('group_bookmark_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
